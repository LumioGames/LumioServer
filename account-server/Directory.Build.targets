<Project>
  <Target Name="ValidateAccountServerBuildProfile" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(AccountServerProductionProject)' == 'true' AND (
             $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('xunit')) OR
             $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Microsoft.NET.Test.Sdk')))"
           Text="ACCOUNT_SERVER_BUILD_PROFILE: production project $(MSBuildProjectName) must not reference test package %(PackageReference.Identity)." />

    <Error Condition="'$(TargetFramework)' != 'net10.0'"
           Text="ACCOUNT_SERVER_BUILD_PROFILE: $(MSBuildProjectName) TargetFramework must be net10.0, was '$(TargetFramework)'." />

    <Error Condition="'$(LangVersion)' != '14.0'"
           Text="ACCOUNT_SERVER_BUILD_PROFILE: $(MSBuildProjectName) LangVersion must be 14.0, was '$(LangVersion)'." />
  </Target>
</Project>
