<Project DefaultTargets="Build">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
  </PropertyGroup>

  <ItemGroup>
    <TraversalProject Include="src/**/*.csproj" />
    <TraversalProject Include="tests/**/*.csproj" />
  </ItemGroup>

  <Target Name="Restore">
    <MSBuild Projects="@(TraversalProject)"
             Targets="Restore"
             BuildInParallel="false"
             Condition="'@(TraversalProject)' != ''" />
  </Target>

  <Target Name="Build">
    <MSBuild Projects="@(TraversalProject)"
             Targets="Build"
             BuildInParallel="false"
             Condition="'@(TraversalProject)' != ''" />
  </Target>

  <Target Name="Clean">
    <MSBuild Projects="@(TraversalProject)"
             Targets="Clean"
             BuildInParallel="false"
             Condition="'@(TraversalProject)' != ''" />
  </Target>

  <Target Name="Rebuild" DependsOnTargets="Clean;Build" />
</Project>
