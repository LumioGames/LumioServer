<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- clear 必须在最前：继承来的机器级源会绕过下面的 packageSourceMapping。 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </auditSources>

  <config>
    <add key="auditMode" value="all" />
    <add key="auditLevel" value="low" />
  </config>

</configuration>
